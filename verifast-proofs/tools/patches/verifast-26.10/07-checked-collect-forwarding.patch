+                match &statement.kind {
+                    mir::StatementKind::Assign(assignment) => {
+                        let (dst, value) = &**assignment;
+                        dst.projection.is_empty() && dst.local != env && dst.local != input && match value {
+                            mir::Rvalue::Use(operand, _) => safe_operand(operand),
+                            mir::Rvalue::BinaryOp(
+                                mir::BinOp::Eq | mir::BinOp::Ne | mir::BinOp::Lt | mir::BinOp::Le
+                                | mir::BinOp::Gt | mir::BinOp::Ge, operands,
