+                match operand {
+                    mir::Operand::Copy(place) | mir::Operand::Move(place) => fields_only(place),
+                    mir::Operand::Constant(_) => true,
+                    mir::Operand::RuntimeChecks(_) => false,
+                }
+            };
+            let moves_input = |operand: &mir::Operand<'tcx>| {
+                matches!(operand, mir::Operand::Move(place) if place.local == input && place.projection.is_empty())
+            };
