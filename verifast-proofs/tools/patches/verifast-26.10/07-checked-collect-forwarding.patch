+            let mut return_block = None;
+            for (index, block) in body.basic_blocks.iter_enumerated().filter(|(_, block)| !block.is_cleanup) {
+                for statement in &block.statements {
+                    match &statement.kind {
+                        mir::StatementKind::Assign(assignment) => {
+                            let (place, value) = &**assignment;
+                            if !place.projection.is_empty() || place.local == input || place.local == mir::RETURN_PLACE
+                                || match value {
+                                    mir::Rvalue::Use(operand, _) => !stored_operand(operand),
+                                    mir::Rvalue::Ref(_, mir::BorrowKind::Shared, place) => !fields_only(place),
+                                    mir::Rvalue::Aggregate(kind, operands) => {
+                                        let safe_kind = match &**kind {
+                                            mir::AggregateKind::Array(_) | mir::AggregateKind::Tuple => true,
+                                            mir::AggregateKind::Closure(def_id, _) => Self::pure_collect_guard(tcx, body.source.def_id(), *def_id),
+                                            _ => false,
+                                        };
+                                        !safe_kind || !operands.iter().all(stored_operand)
+                                    }
+                                    _ => true,
+                                }
+                            {
+                                return false;
+                            }
+                        }
+                        mir::StatementKind::StorageLive(_) | mir::StatementKind::StorageDead(_) | mir::StatementKind::Nop => {}
+                        _ => return false,
