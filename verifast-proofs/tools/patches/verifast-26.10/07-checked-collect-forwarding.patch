+                    mir::TerminatorKind::Drop { place, target, unwind, .. } =>
+                        place.local == input && place.projection.is_empty() && is_cleanup(*target)
+                            && matches!(unwind, UnwindAction::Terminate(_) | UnwindAction::Unreachable),
+                    mir::TerminatorKind::Goto { target } => is_cleanup(*target),
+                    mir::TerminatorKind::SwitchInt { discr, targets } =>
+                        discr.ty(body, tcx) == tcx.types.bool && targets.all_targets().iter().copied().all(is_cleanup),
+                    mir::TerminatorKind::UnwindResume | mir::TerminatorKind::UnwindTerminate(_) => true,
+                    _ => false,
+                }
+            })
