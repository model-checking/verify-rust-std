+            let safe_operand = |operand: &mir::Operand<'tcx>| {
+                let place = match operand {
+                    mir::Operand::Copy(place) | mir::Operand::Move(place) => place,
+                    mir::Operand::Constant(c) => return matches!(*c.ty().kind(), ty::Uint(ty::UintTy::Usize) | ty::Bool),
+                    mir::Operand::RuntimeChecks(_) => return false,
+                };
