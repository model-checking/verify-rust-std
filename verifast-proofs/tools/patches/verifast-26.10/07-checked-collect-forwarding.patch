+        fn local_collect_dispatch(
+            tcx: TyCtxt<'tcx>,
+            typing_env: ty::TypingEnv<'tcx>,
+            from_iter: ty::Instance<'tcx>,
+            local_bodies: &[(mir::Body<'tcx>, Span)],
+        ) -> Option<Vec<String>> {
+            let mut pending = vec![from_iter];
+            let mut seen = HashMap::new();
+            let mut paths = Vec::new();
