+                {
+                    return None;
+                }
+                match &block.terminator().kind {
+                    mir::TerminatorKind::UnwindResume | mir::TerminatorKind::UnwindTerminate(_) => (),
+                    mir::TerminatorKind::SwitchInt { discr, .. } if discr.ty(body, tcx) == tcx.types.bool => (),
+                    mir::TerminatorKind::Drop { place, .. }
+                        if place.projection.is_empty() && place.ty(&body.local_decls, tcx).ty == body.local_decls[range].ty => (),
+                    _ => return None,
