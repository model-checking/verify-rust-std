+        fn read_index_locals(
+            tcx: TyCtxt<'tcx>,
+            body: &mir::Body<'tcx>,
+            block: &mir::BasicBlockData<'tcx>,
+            locals: &mut HashMap<mir::Local, IndexOperand>,
+        ) -> bool {
+            block.statements.iter().all(|statement| match &statement.kind {
+                mir::StatementKind::StorageLive(local) | mir::StatementKind::StorageDead(local) => {
+                    locals.remove(local);
+                    true
+                }
+                mir::StatementKind::Assign(assign) => {
+                    let (dst, value) = &**assign;
+                    if !dst.projection.is_empty() {
+                        return false;
+                    }
+                    match value {
+                        mir::Rvalue::Use(mir::Operand::Move(src) | mir::Operand::Copy(src), _)
+                            if src.projection.is_empty() =>
+                        {
+                            let Some(origin) = locals.get(&src.local).copied() else { return false };
+                            locals.insert(dst.local, origin);
+                            true
+                        }
+                        mir::Rvalue::Ref(_, mir::BorrowKind::Shared, src)
+                            if matches!(&src.projection[..], [mir::ProjectionElem::Deref]) =>
+                        {
+                            let Some(origin) = locals.get(&src.local).copied() else { return false };
+                            locals.insert(dst.local, origin);
+                            true
