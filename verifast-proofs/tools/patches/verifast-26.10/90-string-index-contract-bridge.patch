+                    &block.terminator().kind else { return None };
+                let ty::FnDef(callee, _) = *func.ty(body, tcx).kind() else { return None };
+                let origin = |arg: &mir::Operand<'_>| {
+                    match arg {
+                        mir::Operand::Copy(place) | mir::Operand::Move(place) if place.projection.is_empty() =>
+                            locals.get(&place.local).copied(),
