+            // An unknown trait or receiver, including recursion beyond the
+            // analysis depth, stays possible and cannot exclude a candidate.
+            let name = tcx.def_path_str(trait_id);
+            if depth == 0 || !matches!(receiver.kind(), ty::Adt(_, _))
+                || !["::TrustedLen", "::InPlaceCollect", "::InPlaceIterable", "::SourceIter"]
+                    .iter().any(|suffix| name.ends_with(suffix))
+            {
+                return true;
+            }
+            let mut possible = false;
+            tcx.for_each_relevant_impl(trait_id, receiver, |implementation| {
+                let header = tcx.impl_trait_ref(implementation).instantiate_identity().skip_normalization();
+                let self_ty = header.self_ty();
+                let may_unify = ty::fast_reject::DeepRejectCtxt::relate_infer_infer(tcx);
+                if !may_unify.types_may_unify(receiver, self_ty) {
+                    return;
+                }
+                let impossible = matches!(self_ty.kind(), ty::Param(_))
+                    && tcx.clauses_of(implementation).clauses.iter().any(|&(clause, _)| {
+                        let ty::ClauseKind::Trait(bound) = clause.kind().skip_binder() else { return false };
