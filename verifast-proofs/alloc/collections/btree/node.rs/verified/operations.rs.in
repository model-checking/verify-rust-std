use std::{alloc::Global, boxed::Box, mem::ManuallyDrop};

pub struct BTreeMap<
    K,
    V,
    A: AllocatorClone = Global,
> {
    root: Option<Root<K, V>>,
    length: usize,
    /// `ManuallyDrop` to control drop order (needs to be dropped after all the nodes).
    // Although some of the accessory types store a copy of the allocator, the nodes do not.
    // Because allocations will remain live as long as any copy (like this one) of the allocator
    // is live, it's unnecessary to store the allocator in each node.
    alloc: ManuallyDrop<A>,
    // For dropck; the `Box` avoids making the `Unpin` impl more strict than before
    _marker: PhantomData<Box<(K, V), A>>,
}

pub struct CursorMutKey<
    'a,
    K: 'a,
    V: 'a,
    A = Global,
> {
    // If current is None then it means the tree has not been allocated yet.
    current: Option<Handle<NodeRef<marker::Mut<'a>, K, V, marker::Leaf>, marker::Edge>>,
    root: DormantMutRef<'a, Option<Root<K, V>>>,
    length: &'a mut usize,
    alloc: &'a mut A,
}

pub struct VacantEntry<
    'a,
    K,
    V,
    A: AllocatorClone = Global,
> {
    key: K,
    /// `None` for a (empty) map without root
    handle: Option<Handle<NodeRef<marker::Mut<'a>, K, V, marker::Leaf>, marker::Edge>>,
    dormant_map: DormantMutRef<'a, BTreeMap<K, V, A>>,

    /// The BTreeMap will outlive this IntoIter so we don't care about drop order for `alloc`.
    alloc: A,

    // Be invariant in `K` and `V`
    _marker: PhantomData<&'a mut (K, V)>,
}

type RootInputs<'a, K, V, A> = (&'a mut Root<K, V>, A, K, V, Root<K, V>);

impl<'a, K, V, A: AllocatorClone> CursorMutKey<'a, K, V, A> {
    fn project_root_inputs_0(
        &mut self, split: Option<SplitResult<'a, K, V, marker::LeafOrInternal>>,
    ) -> Option<RootInputs<'a, K, V, A>> {
        let capture = &mut self.root;
        let alloc = &*self.alloc;
        match split {
            None => None,
            Some(ins) => {
                drop(ins.left);
                let root = unsafe { capture.reborrow().as_mut().unwrap() };
                let inputs = (root, alloc.clone(), ins.kv.0, ins.kv.1, ins.right);
                Some(inputs)
            }
        }
    }
}

impl<'a, K, V, A: AllocatorClone> CursorMutKey<'a, K, V, A> {
    fn project_root_inputs_1(
        &mut self, split: Option<SplitResult<'a, K, V, marker::LeafOrInternal>>,
    ) -> Option<RootInputs<'a, K, V, A>> {
        let capture = &mut self.root;
        let alloc = &*self.alloc;
        match split {
            None => None,
            Some(ins) => {
                drop(ins.left);
                let root = unsafe { capture.reborrow().as_mut().unwrap() };
                let inputs = (root, alloc.clone(), ins.kv.0, ins.kv.1, ins.right);
                Some(inputs)
            }
        }
    }
}

impl<'a, K, V, A: AllocatorClone> VacantEntry<'a, K, V, A> {
    fn project_root_inputs_0(
        &mut self, split: Option<SplitResult<'a, K, V, marker::LeafOrInternal>>,
    ) -> Option<RootInputs<'a, K, V, A>> {
        let capture = &mut self.dormant_map;
        let alloc = &self.alloc;
        match split {
            None => None,
            Some(ins) => {
                drop(ins.left);
                let map = unsafe { capture.reborrow() };
                let root = map.root.as_mut().unwrap();
                let inputs = (root, alloc.clone(), ins.kv.0, ins.kv.1, ins.right);
                Some(inputs)
            }
        }
    }
}
