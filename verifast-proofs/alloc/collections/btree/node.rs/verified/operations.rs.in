unsafe fn merge_field<T>(
    parent: *mut MaybeUninit<T>,
    left: *mut MaybeUninit<T>,
    right: *mut MaybeUninit<T>,
    parent_idx: usize,
    old_parent_len: usize,
    old_left_len: usize,
    right_len: usize,
    new_left_len: usize,
)
/*@
req thread_token(?t) &*& type_interp::<T>() &*&
    0 <= parent_idx &*& parent_idx < old_parent_len &*& old_parent_len <= CAPACITY &*&
    0 <= old_left_len &*& 0 <= right_len &*& new_left_len == old_left_len + 1 + right_len &*& new_left_len <= CAPACITY &*&
    parent[..CAPACITY] |-> ?p &*& left[..CAPACITY] |-> ?l &*& right[..CAPACITY] |-> ?r &*&
    slot_owners(t, take(old_parent_len, p)) &*& slot_owners(t, take(old_left_len, l)) &*&
    slot_owners(t, take(right_len, r));
@*/
/*@
ens thread_token(t) &*& type_interp::<T>() &*&
    parent[..CAPACITY] |-> ?p_after &*& left[..CAPACITY] |-> ?l_after &*& right[..CAPACITY] |-> r &*&
    slot_owners(t, take(old_parent_len - 1, p_after)) &*& slot_owners(t, take(new_left_len, l_after));
@*/
//@ on_unwind_ens false;
{
    //@ own_move_array(parent, CAPACITY);
    //@ own_move_array(left, CAPACITY);
    //@ own_move_array(right, CAPACITY);
    //@ split_move_slice(parent, CAPACITY, old_parent_len);
    //@ split_move_slice(left, CAPACITY, new_left_len);
    //@ split_move_slice(right, CAPACITY, right_len);
    //@ take_twice(l, old_left_len, new_left_len);
    unsafe { merge_payload(parent, left, right, parent_idx, old_parent_len, old_left_len, right_len, new_left_len) };
    //@ assert move_slice(parent, old_parent_len, ?new_p);
    //@ assert move_slice(left, new_left_len, ?new_l);
    //@ move_slice_length(parent, old_parent_len);
    //@ move_slice_length(left, new_left_len);
    //@ join_move_slices(parent, old_parent_len, CAPACITY - old_parent_len);
    //@ join_move_slices(left, new_left_len, CAPACITY - new_left_len);
    //@ join_move_slices(right, right_len, CAPACITY - right_len);
    //@ take_append_l(old_parent_len - 1, new_p, drop(old_parent_len, p));
    //@ take_append_l(new_left_len, new_l, drop(new_left_len, l));
    //@ take_length(new_l);
    //@ append_take_drop_n(r, right_len);
    //@ open move_slice(parent, CAPACITY, _);
    //@ open move_slice(left, CAPACITY, _);
    //@ open move_slice(right, CAPACITY, r);
}

