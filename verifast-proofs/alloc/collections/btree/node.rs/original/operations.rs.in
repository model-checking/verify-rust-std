unsafe fn read_promoted<T>(slot: *const MaybeUninit<T>) -> T
//@ req thread_token(?t) &*& type_interp::<T>() &*& *slot |-> ?bits &*& bits.inner() == some(?value) &*& <T>.own(t,value);
//@ ens thread_token(t) &*& type_interp::<T>() &*& *slot |-> MaybeUninit::new(value) &*& result == value &*& <T>.own(t,value);
//@ on_unwind_ens false;
{
    //@ open_MaybeUninit(slot);
    //@ points_to_limits(slot as *T);
    let promoted = unsafe { std::ptr::read(slot as *const T) };
    //@ close_MaybeUninit(slot);
    promoted
}

// SOURCE unsafe fn slice_shl<T>(slice: &mut [MaybeUninit<T>], distance: usize) {

// SOURCE unsafe fn slice_shr<T>(slice: &mut [MaybeUninit<T>], distance: usize) {

// SOURCE fn move_to_slice<T>(src: &mut [MaybeUninit<T>], dst: &mut [MaybeUninit<T>]) {

// SOURCE unsafe fn slice_remove<T>(slice: &mut [MaybeUninit<T>], idx: usize) -> T {

unsafe fn move_slice_mut<'a, T>(base: *mut MaybeUninit<T>, len: usize) -> &'a mut [MaybeUninit<T>]
//@ req move_slice(base, len, ?slots);
//@ ens move_slice(base, len, slots) &*& result as *MaybeUninit<T> == base &*& result.len() == len;
//@ on_unwind_ens false;
{
    //@ open move_slice(base, len, slots);
    let slice = unsafe { std::slice::from_raw_parts_mut(base, len) };
    //@ close move_slice(base, len, slots);
    slice
}

unsafe fn merge_payload<T>(
    parent: *mut MaybeUninit<T>,
    left: *mut MaybeUninit<T>,
    right: *mut MaybeUninit<T>,
    parent_idx: usize,
    old_parent_len: usize,
    old_left_len: usize,
    right_len: usize,
    new_left_len: usize,
){
    unsafe {
let entry = slice_remove(move_slice_mut(parent, old_parent_len), parent_idx);
(*left.add(old_left_len)).write(entry);
move_to_slice(
move_slice_mut(right, right_len),
move_slice_mut(left.add(old_left_len + 1), new_left_len - (old_left_len + 1)),
);
    }
}

unsafe fn merge_field<T>(
    parent: *mut MaybeUninit<T>,
    left: *mut MaybeUninit<T>,
    right: *mut MaybeUninit<T>,
    parent_idx: usize,
    old_parent_len: usize,
    old_left_len: usize,
    right_len: usize,
    new_left_len: usize,
)

{
    unsafe { merge_payload(parent, left, right, parent_idx, old_parent_len, old_left_len, right_len, new_left_len) };
}

unsafe fn release_balancing_node<'alloc, T, A: std::alloc::Allocator>(
    node: NonNull<T>,
    alloc: &'alloc A,
)

{
    let ptr = node.as_ptr();
    let bytes = unsafe { NonNull::new_unchecked(ptr as *mut u8) };
    unsafe { alloc.deallocate(bytes, std::alloc::Layout::new::<T>()) }
}

unsafe fn merge_keys<'a, 'short, K, V>(
    parent_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::Internal>,
    left_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>,
    right_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>,
    parent_idx: usize,
    old_parent_len: usize,
    old_left_len: usize,
    right_len: usize,
    new_left_len: usize,
) {
    unsafe {
let parent_key = slice_remove(parent_node.key_area_prefix_mut(..old_parent_len), parent_idx);
left_node.key_area_slot_mut(old_left_len).write(parent_key);
move_to_slice(
right_node.key_area_prefix_mut(..right_len),
left_node.key_area_range_mut(old_left_len + 1..new_left_len),
);
    }
}

unsafe fn merge_vals<'a, 'short, K, V>(
    parent_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::Internal>,
    left_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>,
    right_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>,
    parent_idx: usize,
    old_parent_len: usize,
    old_left_len: usize,
    right_len: usize,
    new_left_len: usize,
) {
    unsafe {
let parent_val = slice_remove(parent_node.val_area_prefix_mut(..old_parent_len), parent_idx);
left_node.val_area_slot_mut(old_left_len).write(parent_val);
move_to_slice(
right_node.val_area_prefix_mut(..right_len),
left_node.val_area_range_mut(old_left_len + 1..new_left_len),
);
    }
}

unsafe fn remove_merged_edge<'a, 'short, K, V>(
    parent_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::Internal>,
    parent_idx: usize,
    old_parent_len: usize,
) {
    unsafe {
slice_remove(parent_node.edge_area_prefix_mut(..old_parent_len + 1), parent_idx + 1);
parent_node.relink_range(parent_idx + 1..old_parent_len);
*parent_node.len_mut() -= 1;
    }
}

unsafe fn append_merged_edges<'a, 'short, K, V>(
    left_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::Internal>,
    right_node: &'short mut NodeRef<marker::Mut<'a>, K, V, marker::Internal>,
    old_left_len: usize,
    right_len: usize,
    new_left_len: usize,
) {
    unsafe {
move_to_slice(
right_node.edge_area_prefix_mut(..right_len + 1),
left_node.edge_area_range_mut(old_left_len + 1..new_left_len + 1),
);
left_node.relink_range(old_left_len + 1..new_left_len + 1);
    }
}

