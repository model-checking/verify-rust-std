impl<BorrowType, K, V> Handle<NodeRef<BorrowType, K, V, marker::LeafOrInternal>, marker::Edge> {
    unsafe fn new_edge(node: NodeRef<BorrowType, K, V, marker::LeafOrInternal>, idx: usize) -> Self {
        debug_assert!(idx <= node.merge_len());

        Handle { node, idx, _marker: PhantomData }
    }
}

impl<'a, K: 'a, V: 'a> BalancingContext<'a, K, V> {
    fn merge_tracking_child<A: std::alloc::Allocator>(
        self,
        alloc: A,
    ) -> NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal> {
        self.merge_child_production(alloc)
    }

// SOURCE     fn do_merge<

    fn merge_tracking_child_edge<A: std::alloc::Allocator>(
        self,
        track_edge_idx: LeftOrRight<usize>,
        alloc: A,
    ) -> Handle<NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>, marker::Edge> {
        let old_left_len = self.left_child.merge_len();
        let right_len = self.right_child.merge_len();
        assert!(match track_edge_idx {
            LeftOrRight::Left(idx) => idx <= old_left_len,
            LeftOrRight::Right(idx) => idx <= right_len,
        });
        let child = self.merge_tracking_child(alloc);
        let new_idx = match track_edge_idx {
            LeftOrRight::Left(idx) => idx,
            LeftOrRight::Right(idx) => old_left_len + 1 + idx,
        };
        // ignore-tidy-undocumented-unsafe
        unsafe { Handle::<NodeRef<_, K, V, marker::LeafOrInternal>, marker::Edge>::new_edge(child, new_idx) }
    }
}

fn select_merged_child<'a,K,V>(
    _parent: NodeRef<marker::Mut<'a>, K, V, marker::Internal>,
    child: NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>,
) -> NodeRef<marker::Mut<'a>, K, V, marker::LeafOrInternal>
{
    child
}

unsafe fn borrow_initialized_slot<'short,T>(slot: &'short mut MaybeUninit<T>) -> &'short mut T
{
    unsafe { &mut *slot.as_mut_ptr() }
}

/*@
fix replace_slot<T>(index: usize, entry: T, slots: list<T>) -> list<T> {
    append(take(index,slots),cons(entry,drop(index+1,slots)))
}
@*/

impl<'a, K:'a, V:'a, NodeType> Handle<NodeRef<marker::Mut<'a>,K,V,NodeType>,marker::KV> {
    unsafe fn replace_kv_production<'short>(&'short mut self, k:K, v:V) -> (K,V)
    {
        debug_assert!(self.idx < self.node.merge_len());
        let leaf = self.node.as_leaf_mut();
        let key = unsafe { borrow_initialized_slot(leaf.keys.get_unchecked_mut(self.idx)) };
        let val = unsafe { borrow_initialized_slot(leaf.vals.get_unchecked_mut(self.idx)) };
        (std::mem::replace(key, k), std::mem::replace(val, v))
    }
}

enum ForceResult<Leaf, Internal> {
    Leaf(Leaf),
    Internal(Internal),
}

impl<BorrowType, K, V> NodeRef<BorrowType, K, V, marker::LeafOrInternal> {
    unsafe fn force(
        self,
    ) -> ForceResult<
        NodeRef<BorrowType, K, V, marker::Leaf>,
        NodeRef<BorrowType, K, V, marker::Internal>,
    >
    //@ req 0 <= self.height;
    /*@
    ens match result {
        ForceResult::Leaf(leaf) => self.height == 0 &*& leaf.height == self.height &*& leaf.node == self.node,
        ForceResult::Internal(internal) => self.height > 0 &*& internal.height == self.height &*& internal.node == self.node
    };
    @*/
    //@ on_unwind_ens false;
    {
        if self.height == 0 {
            ForceResult::Leaf(NodeRef {
                height: self.height,
                node: self.node,
                _marker: PhantomData,
            })
        } else {
            ForceResult::Internal(NodeRef {
                height: self.height,
                node: self.node,
                _marker: PhantomData,
            })
        }
    }
}


