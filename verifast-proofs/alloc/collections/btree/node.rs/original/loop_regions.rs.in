
const _: () = {
    type LeafRef = NodeRef<marker::Mut<'static>, String, String, marker::Leaf>;
    type InternalRef = NodeRef<marker::Mut<'static>, String, String, marker::Internal>;
    assert!(!std::mem::needs_drop::<Handle<LeafRef, marker::Edge>>());
    assert!(!std::mem::needs_drop::<Handle<InternalRef, marker::Edge>>());
    assert!(!std::mem::needs_drop::<Handle<InternalRef, marker::KV>>());
    assert!(!std::mem::needs_drop::<NodeRef<marker::Mut<'static>, String, String, marker::LeafOrInternal>>());
    assert!(!std::mem::needs_drop::<BalancingContext<'static, String, String>>());
};

use super::borrow::DormantMutRef;

unsafe fn finish_root_split<'tree, 'slot, K, V, A: AllocatorClone>(
    split: SplitResult<'tree, K, V, marker::LeafOrInternal>,
    inserted: Handle<NodeRef<marker::DormantMut, K, V, marker::Leaf>, marker::KV>,
    root_slot: &'slot mut DormantMutRef<'tree, Option<Root<K, V>>>,
    allocator: &'slot mut A,
) -> Handle<NodeRef<marker::Mut<'tree>, K, V, marker::Leaf>, marker::KV>
{
    let root = unsafe { root_slot.reborrow().as_mut().unwrap() };
    root.push_internal_level(allocator.clone()).push(split.kv.0, split.kv.1, split.right);
    unsafe { inserted.awaken() }
}

