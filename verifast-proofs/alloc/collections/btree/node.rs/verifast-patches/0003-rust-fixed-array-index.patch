diff --git a/tests/rust/purely_unsafe/fixed_array_index.rs b/tests/rust/purely_unsafe/fixed_array_index.rs
new file mode 100644
index 0000000..c9ac59a
--- /dev/null
+++ b/tests/rust/purely_unsafe/fixed_array_index.rs
@@ -0,0 +1,21 @@
+struct Node {
+    edges: [i32; 12],
+}
+
+unsafe fn set_edge(node: *mut Node, index: usize, child: i32)
+//@ req index < 12 &*& pointer_within_limits(&(*node).edges) == true &*& *(&(*node).edges as *i32 + index) |-> _;
+//@ ens *(&(*node).edges as *i32 + index) |-> child;
+//@ on_unwind_ens false;
+{
+    //@ assert index < 12;
+    unsafe { (*node).edges[index] = child };
+}
+
+unsafe fn first_edge(node: *const Node) -> i32
+//@ req pointer_within_limits(&(*node).edges) == true &*& *(&(*node).edges as *i32) |-> ?edge;
+//@ ens *(&(*node).edges as *i32) |-> edge &*& result == edge;
+//@ on_unwind_ens false;
+{
+    //@ assert 0 < 12;
+    unsafe { (*node).edges[0] }
+}
