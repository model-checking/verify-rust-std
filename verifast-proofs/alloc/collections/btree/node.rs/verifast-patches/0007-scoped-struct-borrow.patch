index 0000000..168799c
--- /dev/null
+++ b/tests/rust/purely_unsafe/mutable_struct_borrow.rs
@@ -0,0 +1,23 @@
+struct Record { size: u16, entries: [u16; 2] }
+
+unsafe fn borrow_record<'a>(ptr: *mut Record) -> &'a mut Record
+//@ req *ptr |-> ?value;
+//@ ens *result |-> value &*& ref_mut_end_token(result, ptr) &*& ref_origin(result) == ref_origin(ptr);
+//@ on_unwind_ens false;
+{
+    unsafe { &mut *ptr } //~track_ref_creation
+}
+
+unsafe fn update(ptr: *mut Record)
+//@ req *ptr |-> ?value;
+//@ ens *ptr |-> Record { size: 1, entries: value.entries };
+//@ on_unwind_ens false;
+{
+    let reference = unsafe { borrow_record(ptr) };
+    //@ open_points_to(reference);
+    reference.size = 1;
+    //@ close_points_to(reference);
+    //@ end_ref_mut(reference);
+}
+
+fn main() {}
