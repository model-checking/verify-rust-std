diff --git a/tests/rust/refinement_checker/raw-pointer_orig.rs b/tests/rust/refinement_checker/raw-pointer_orig.rs
new file mode 100644
index 0000000..aee9572
--- /dev/null
+++ b/tests/rust/refinement_checker/raw-pointer_orig.rs
@@ -0,0 +1,17 @@
+#[repr(C)]
+struct Pair {
+    left: i32,
+    right: i32,
+}
+
+unsafe fn field_addr(pair: *mut Pair) -> usize {
+    let field = unsafe { &raw mut (*pair).left };
+    field as usize
+}
+
+fn local_addr() -> i32 {
+    let mut value = 1;
+    let ptr = &raw mut value;
+    unsafe { *ptr = 2 };
+    value
+}
