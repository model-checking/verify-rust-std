+unsafe fn drop_with_cleanup<T, U>(value: T, pending: U)
+//@ req thread_token(?t) &*& type_interp::<T>() &*& type_interp::<U>() &*& <T>.own(t, value) &*& <U>.own(t, pending);
+//@ ens thread_token(t) &*& type_interp::<T>() &*& type_interp::<U>();
+//@ on_unwind_ens thread_token(t) &*& type_interp::<T>() &*& type_interp::<U>();
+{
+    let mut cleanup = pending;
+    //@ close_points_to(&mut cleanup);
+    let mut primary = value;
+    //@ close_points_to(&mut primary);
+}
+
+unsafe fn cannot_rule_out_unwind<T>(value: T)
+//@ req thread_token(?t) &*& type_interp::<T>() &*& <T>.own(t, value);
+//@ ens thread_token(t) &*& type_interp::<T>();
+//@ on_unwind_ens false; //~should_fail
+{
+    let mut primary = value;
+    //@ close_points_to(&mut primary);
+}
+
+fn main() {}
