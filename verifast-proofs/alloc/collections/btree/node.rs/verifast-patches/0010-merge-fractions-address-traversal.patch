@@ -0,0 +1,13 @@
+unsafe fn write_after_merge(ptr: *mut u8) -> u8
+//@ req [1/2](*ptr |-> ?value) &*& [1/2](*ptr |-> value);
+//@ ens *ptr |-> value &*& result == 2;
+//@ on_unwind_ens false;
+{
+    //@ merge_fractions points_to(ptr, _);
+    let mut local = 1;
+    let address = &raw mut local;
+    unsafe { *address = 2 };
+    local
+}
+
+fn main() {}
