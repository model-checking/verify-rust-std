@@ -0,0 +1,46 @@
+#![allow(dead_code)]
+
+unsafe fn replace_borrowed_box_contents(mut owner: Box<i32>, value: i32) -> Box<i32>
+/*@
+req thread_token(?t) &*& std::boxed::Box_in(t, owner, ?id, _) &*&
+    exists::<lifetime_t>(?k) &*& [?q]lifetime_token(k) &*& lifetime_inclusion(k, id.lft) == true;
+@*/
+//@ ens thread_token(t) &*& std::boxed::Box_in(t, result, id, value) &*& [q]lifetime_token(k);
+//@ on_unwind_ens false;
+{
+    //@ open exists(k);
+    let view = &mut owner; //~track_ref_creation
+    //@ let contents = std::boxed::Box_separate_contents(view);
+    //@ let traded = lifetime_token_trade(k, q, id.lft);
+    //@ open_points_to_at_lft(contents, traded);
+    //@ points_to_limits(contents);
+    let destination: &mut i32 = view; //~track_ref_creation
+    *destination = value;
+    //@ end_ref_mut(destination);
+    //@ close_points_to_at_lft(contents);
+    //@ lifetime_token_trade_back(traded, id.lft);
+    //@ std::boxed::Box_unseparate_contents(view);
+    //@ end_ref_mut(view);
+    owner
+}
+
+unsafe fn borrow_another_box(mut owner: Box<i32>, mut other: Box<i32>)
+/*@
+req thread_token(?t) &*& std::boxed::Box_in(t, owner, ?id, _) &*& std::boxed::Box_in(t, other, _, _) &*&
+    exists::<lifetime_t>(?k) &*& [?q]lifetime_token(k) &*& lifetime_inclusion(k, id.lft) == true;
+@*/
+//@ ens thread_token(t) &*& [q]lifetime_token(k);
+//@ on_unwind_ens false;
+{
+    //@ open exists(k);
+    let _view = &mut owner; //~track_ref_creation
+    //@ let contents = std::boxed::Box_separate_contents(_view);
+    //@ let traded = lifetime_token_trade(k, q, id.lft);
+    //@ open_points_to_at_lft(contents, traded);
+    //@ points_to_limits(contents);
+
+    let other_view = &mut other; //~track_ref_creation
+    let _destination: &mut i32 = other_view; //~should_fail
+}
+
+fn main() {}
