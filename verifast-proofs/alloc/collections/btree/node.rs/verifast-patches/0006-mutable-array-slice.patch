index 0000000..dc08696
--- /dev/null
+++ b/tests/rust/purely_unsafe/mutable_array_slice.rs
@@ -0,0 +1,58 @@
+unsafe fn update_array(array: *mut [u32; 3], first: usize, last: usize)
+//@ req (array as *u32)[..3] |-> ?slots &*& first < 3 &*& first <= last &*& last <= 3;
+//@ ens (array as *u32)[..3] |-> append(take(first, slots), cons(42, drop(first + 1, slots)));
+//@ on_unwind_ens false;
+{
+    //@ close_points_to(array);
+    unsafe {
+        let borrowed = &mut *array;
+        let values = borrowed.as_mut_slice();
+        let base = values.as_mut_ptr();
+        //@ open_points_to(borrowed);
+
+        //@ array_split(base, first);
+        //@ array_split(base + first, last - first);
+        let range = values.get_unchecked_mut(first..last);
+        //@ assert range.len() == last - first;
+        //@ end_slice_ref_mut(range);
+        //@ array_join(base + first);
+        //@ array_join(base);
+
+        //@ array_split(base, last);
+        let prefix = values.get_unchecked_mut(..last);
+        //@ assert prefix.len() == last;
+        //@ end_slice_ref_mut(prefix);
+        //@ array_join(base);
+
+        //@ array_split(base, first);
+        //@ array_split(base + first, 1);
+        //@ open array(base + first, 1, _);
+        let slot = values.get_unchecked_mut(first);
+        //@ points_to_limits(slot);
+        *slot = 42;
+        //@ end_ref_mut(slot);
+        //@ close array(base + first, 1, [42]);
+        //@ array_join(base + first);
+        //@ array_join(base);
+        //@ length_drop(first, slots);
+        //@ drop_n_plus_one(first, slots);
+        //@ close_points_to(borrowed);
+        //@ end_ref_mut(borrowed);
+    }
+    //@ open_points_to(array);
+}
+
+unsafe fn reject_write_through_parent(x: &mut [u32]) -> u32
+//@ req 0 < x.len() &*& *(x as *u32) |-> ?value;
+//@ ens *(x as *u32) |-> value &*& result == value;
+//@ on_unwind_ens false;
+{
+    let old = x.as_mut_ptr();
+    let borrow = unsafe { x.get_unchecked_mut(0) };
+    unsafe { *old = 42 }; //~should_fail
+    let observed = *borrow;
+    //@ end_ref_mut(borrow);
+    observed
+}
+
+fn main() {}
