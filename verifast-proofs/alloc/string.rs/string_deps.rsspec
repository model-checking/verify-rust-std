        fn chain_owned_vec_and_once<T>(self: std::vec::IntoIter<T, std::alloc::Global>, other: std::iter::Once<T>)
            -> std::iter::Chain<std::vec::IntoIter<T, std::alloc::Global>, std::iter::Once<T>>;
        /*@
        req thread_token(?t) &*& std::iter::VecRejectionIter(t, self, ?elems) &*&
