mod vec {

    struct IntoIter<T, A>;

    struct Drain<'a, T, A>;

    struct Splice<'a, I, A>;

    /*@
    // Precise view of a `Vec` minus its initialized elements `buffer[..len]`
    // (combining `Vec_minus_buffer` and uninitialized spare capacity `buffer[len..capacity]`).
    // `Vec_buf(self)` is the pure buffer pointer stored inside the `Vec` value.
    fix Vec_buf<T, A>(self: Vec<T, A>) -> *T;

    pred Vec_minus_elems<T, A>(self: Vec<T, A>, capacity: usize, len: usize, buffer: *T;);

    lem Vec_separate_elems<T, A>(self: Vec<T, A>) -> *T;
        req [?f]Vec::<T, A>(self, ?capacity, ?elems);
        ens [f]Vec_minus_elems::<T, A>(self, capacity, length(elems), result) &*&
            [f]result[..length(elems)] |-> elems &*&
            result == Vec_buf(self);

    lem Vec_unseparate_elems<T, A>(self: Vec<T, A>);
        req [?f]Vec_minus_elems::<T, A>(self, ?capacity, ?len, ?buffer) &*&
            [f]buffer[..len] |-> ?elems;
        ens [f]Vec::<T, A>(self, capacity, elems) &*&
            buffer == Vec_buf(self);

    lem Vec_u8_to_own(t: thread_id_t, self: Vec<u8, std::alloc::Global>);
        req Vec::<u8, std::alloc::Global>(self, ?capacity, ?elems);
        ens <Vec<u8, std::alloc::Global>>.own(t, self);

    lem Vec_minus_buffer_merge<T, A>(self: Vec<T, A>);
        req [?f1]Vec_minus_buffer::<T, A>(self, ?cap, ?len, ?buf) &*& [?f2]Vec_minus_buffer::<T, A>(self, cap, len, buf);
        ens [f1 + f2]Vec_minus_buffer::<T, A>(self, cap, len, buf);

    // For a non-zero-sized element type, separate the initialized elements
    // and the writable storage above the length without making it readable.
    lem Vec_separate_spare<T, A>(self: Vec<T, A>) -> *T;
        req Vec::<T, A>(self, ?capacity, ?elems) &*& std::mem::size_of::<T>() > 0;
        ens Vec_minus_buffer::<T, A>(self, capacity, length(elems), result) &*&
            result[..length(elems)] |-> elems &*& array_(result + length(elems), capacity - length(elems), _);

    lem Vec_unseparate_spare<T, A>(self: Vec<T, A>);
        req Vec_minus_buffer::<T, A>(self, ?capacity, ?len, ?buffer) &*&
            buffer[..len] |-> ?elems &*& array_(buffer + len, capacity - len, _) &*& std::mem::size_of::<T>() > 0;
        ens Vec::<T, A>(self, capacity, elems);

    // Each exclusive handle holds the vector until its iterator is destroyed.
    // The splice handle also holds the byte loan used by the replacement iterator.
    pred vec_byte_drain_handle<'a, T, A>(drain: Drain<'a, T, A>;
        vec_ptr: *Vec<T, A>, post_elems: list<T>);

    pred vec_byte_splice_handle<'a, I, T, A>(splice: Splice<'a, I, A>;
        vec_ptr: *Vec<T, A>, post_elems: list<T>, rep_ptr: *u8, rep_len: usize,
        rep_frac: real, rep_bytes: list<u8>);

    fix cast_u8_list<T>(xs: list<u8>) -> list<T>;

    lem_auto(cast_u8_list::<u8>(xs)) cast_u8_list_u8(xs: list<u8>);
        req true;
        ens cast_u8_list::<u8>(xs) == xs;
    @*/

    impl<T> Vec<T> {

        fn with_capacity(capacity: usize) -> Vec<T, std::alloc::Global>;
        //@ req true;
        //@ ens Vec(result, ?cap, []) &*& capacity <= cap;
        //@ on_unwind_ens true;

    }

    impl<T, A> Vec<T, A> {

        fn capacity<'a>(self: &'a Vec<T, A>) -> usize;
        //@ req [?f](*self |-> ?v) &*& [?fv]Vec::<T, A>(v, ?cap, ?elems) &*& std::mem::size_of::<T>() > 0;
        //@ ens [f](*self |-> v) &*& [fv]Vec::<T, A>(v, cap, elems) &*& result == cap;
        //@ on_unwind_ens false;

        fn as_slice<'a>(self: &'a Vec<T, A>) -> &'a [T];
        //@ req [?f](*self |-> ?v) &*& [?fv]Vec_minus_elems::<T, A>(v, ?cap, ?len, ?buf);
        //@ ens [f](*self |-> v) &*& [fv]Vec_minus_elems::<T, A>(v, cap, len, buf) &*& result as *T == buf &*& result.len() == len;
        //@ on_unwind_ens false;

        fn into_boxed_slice(self: Vec<T, A>) -> std::boxed::Box<[T], A>;
        /*@
        req thread_token(?t) &*& Vec::<T, A>(self, _, ?elems) &*&
            typeid(T) == typeid(u8) &*& typeid(A) == typeid(std::alloc::Global);
        @*/
        //@ ens thread_token(t) &*& std::boxed::Box_in::<[T], A>(t, result, _, slice_of_elems(elems));
        //@ on_unwind_ens thread_token(t);

        fn as_mut_slice<'a>(self: &'a mut Vec<T, A>) -> &'a mut [T];
        //@ req (*self |-> ?v) &*& Vec_minus_elems::<T, A>(v, ?cap, ?len, ?buf);
        //@ ens (*self |-> v) &*& Vec_minus_elems::<T, A>(v, cap, len, buf) &*& result as *T == buf &*& result.len() == len;
        //@ on_unwind_ens false;

        fn extend_from_slice<'a, 'b>(self: &'a mut Vec<T, A>, other: &'b [T]);
        //@ req *self |-> ?v0 &*& Vec::<T, A>(v0, _, ?elems) &*& [?f](other as *T)[..other.len()] |-> ?other_elems &*& typeid(T) == typeid(u8) &*& typeid(A) == typeid(std::alloc::Global);
        //@ ens *self |-> ?v1 &*& Vec::<T, A>(v1, _, append(elems, other_elems)) &*& [f](other as *T)[..other.len()] |-> other_elems;
        //@ on_unwind_ens *self |-> ?v1 &*& Vec::<T, A>(v1, _, elems) &*& [f](other as *T)[..other.len()] |-> other_elems;

        // `Vec::split_off(at)`: panics if `at > len`; otherwise splits into `[0..at)` and `[at..len)`.
        fn split_off<'a>(self: &'a mut Vec<T, A>, at: usize) -> Vec<T, A>;
        //@ req *self |-> ?v0 &*& Vec::<T, A>(v0, ?cap, ?elems) &*& 0 <= at &*& at <= length(elems);
        //@ ens *self |-> ?v1 &*& Vec::<T, A>(v1, cap, take(at, elems)) &*& Vec::<T, A>(result, _, drop(at, elems));
        //@ on_unwind_ens *self |-> ?v1 &*& Vec::<T, A>(v1, cap, elems);

        fn leak<'a>(self: Vec<T, A>) -> &'a mut [T];
        //@ req Vec::<T, A>(self, _, ?elems);
        //@ ens (result as *T)[..result.len()] |-> elems &*& result.len() == length(elems);
        //@ on_unwind_ens false;

        // The byte-drain destructor restores the vector and moves its tail.
        fn drain<R, 'a>(self: &'a mut Vec<T, A>, range: R) -> Drain<'a, T, A>;
        /*@
        req thread_token(?t) &*& *self |-> ?v0 &*& Vec::<T, A>(v0, ?cap, ?elems) &*&
            typeid(T) == typeid(u8) &*& typeid(A) == typeid(std::alloc::Global) &*&
            typeid(R) == typeid(std::ops::Range<usize>) &*&
            std::str::str_slice_index_range::<R>(range) == pair(?start, ?end) &*&
            0 <= start &*& start <= end &*& end <= length(elems);
        @*/
        /*@
        ens thread_token(t) &*& <Drain<'a, T, A>>.own(t, result) &*&
            vec_byte_drain_handle(result, self, append(take(start, elems), drop(end, elems)));
        @*/
        //@ on_unwind_ens false;

        // The reserved byte splice reads the replacement before returning either loan.
        fn splice<R, I, 'a>(self: &'a mut Vec<T, A>, range: R, replace_with: I) -> Splice<'a, I, A>;
        /*@
        req thread_token(?t) &*& *self |-> ?v0 &*& Vec::<T, A>(v0, ?cap, ?elems) &*&
            typeid(T) == typeid(u8) &*& typeid(A) == typeid(std::alloc::Global) &*&
            typeid(R) == typeid(std::ops::Range<usize>) &*&
            std::str::str_slice_index_range::<R>(range) == pair(?start, ?end) &*&
            0 <= start &*& start <= end &*& end <= length(elems) &*&
            std::str::is_str_bytes_iter::<I>() == true &*&
            [?fs](std::str::bytes_iter_str::<I>(replace_with) as *u8)[..std::str::bytes_iter_str::<I>(replace_with).len()] |-> ?rep_bs &*&
            length(elems) - (end - start) + length(rep_bs) <= cap;
        @*/
        /*@
        ens thread_token(t) &*& <Splice<'a, I, A>>.own(t, result) &*&
            vec_byte_splice_handle::<'a, I, T, A>(result, self,
                append(take(start, elems), append(cast_u8_list::<T>(rep_bs), drop(end, elems))),
                std::str::bytes_iter_str::<I>(replace_with) as *u8,
                std::str::bytes_iter_str::<I>(replace_with).len(), fs, rep_bs);
        @*/
        //@ on_unwind_ens false;

    }

}

