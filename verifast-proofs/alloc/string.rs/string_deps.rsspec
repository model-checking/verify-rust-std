mod slice {

    // A by-reference binding in a shared byte slice pattern borrows one element.
    fn borrow_constant_u8<'a>(source: &'a [u8], index: usize, min_length: usize) -> &'a u8;
    /*@
    req thread_token(?t) &*& [_](<[u8]>.share(?k, t, source)) &*& [?q]lifetime_token(k) &*&
        index < min_length &*& min_length <= source.len();
    @*/
    /*@
    ens thread_token(t) &*& [q]lifetime_token(k) &*& [_](<u8>.share(k, t, result)) &*&
        result as *u8 as usize == (source as *u8 + index) as usize;
    @*/
    //@ on_unwind_ens false;

    impl<T> [T] {

        fn as_chunks<N, 'a>(self: &'a [T]) -> (&'a [[T; N]], &'a [T]);
        /*@
        req thread_token(?t) &*& [_](<[T]>.share(?k, t, self)) &*& [?q]lifetime_token(k);
        @*/
        /*@
        ens thread_token(t) &*& [q]lifetime_token(k) &*&
            [_](<[[T; N]]>.share(k, t, result.0)) &*& [_](<[T]>.share(k, t, result.1)) &*&
            result.0 as *T == self as *T &*& result.1.len() <= self.len() &*&
            result.1 as *T == self as *T + (self.len() - result.1.len()) &*&
            result.0.len() * std::mem::size_of::<[T; N]>() == (self.len() - result.1.len()) * std::mem::size_of::<T>();
        @*/
        //@ on_unwind_ens thread_token(t) &*& [q]lifetime_token(k);

        unsafe fn align_to<U, 'a>(self: &'a [T]) -> (&'a [T], &'a [U], &'a [T]);
        /*@
        req thread_token(?t) &*& [_](<[T]>.share(?k, t, self)) &*& [?q]lifetime_token(k) &*&
            typeid(T) == typeid(u8) &*& typeid(U) == typeid(u16);
        @*/
        /*@
        ens thread_token(t) &*& [q]lifetime_token(k) &*&
            [_](<[T]>.share(k, t, result.0)) &*& [_](<[U]>.share(k, t, result.1)) &*& [_](<[T]>.share(k, t, result.2)) &*&
            result.0 as *T == self as *T &*&
            result.0.len() + result.1.len() * 2 + result.2.len() == self.len();
        @*/
        //@ on_unwind_ens false;

        fn iter<'a>(self: &'a [T]) -> Iter<'a, T>;
        //@ req thread_token(?t) &*& [_](<[T]>.share(?k, t, self)) &*& [?q]lifetime_token(k);
        //@ ens thread_token(t) &*& [q]lifetime_token(k) &*& <Iter<'a, T>>.own(t, result);
        //@ on_unwind_ens false;

        fn is_empty<'a>(self: &'a [T]) -> bool;
        //@ req thread_token(?t) &*& [_](<[T]>.share(?k, t, self)) &*& [?q]lifetime_token(k);
        //@ ens thread_token(t) &*& [q]lifetime_token(k) &*& result == (self.len() == 0);
        //@ on_unwind_ens false;

    }

    // `core::slice::range(range, ..len)` validates and normalizes `range` to `start..end`
    // with `0 <= start <= end <= len` (panicking otherwise).
    fn range<R>(range: R, bounds: std::ops::RangeTo<usize>) -> std::ops::Range<usize>;
    //@ req thread_token(?t) &*& <R>.own(t, range);
    //@ ens thread_token(t) &*& 0 <= result.start &*& result.start <= result.end &*& result.end <= bounds.end;
    //@ on_unwind_ens thread_token(t);

}

mod str {

    // Linked only after the exporter checks the actual from_boxed_utf8_unchecked body.
    unsafe fn cast_utf8_box(v: std::boxed::Box<[u8], std::alloc::Global>)
        -> std::boxed::Box<str, std::alloc::Global>;
    /*@
    req thread_token(?t) &*& std::boxed::Box_in::<[u8], std::alloc::Global>(t, v, _, ?contents) &*&
        is_valid_utf8(slice_elems(contents)) == true;
    @*/
    //@ ens thread_token(t) &*& <std::boxed::Box<str, std::alloc::Global>>.own(t, result);
    //@ on_unwind_ens false;

    mod pattern {
        /*@
        // The end of the last match returned by this searcher. Its haystack
        // comes from the same shared byte loan used by Pattern::into_searcher.
        pred SearcherPosition<S>(t: thread_id_t, state: S; haystack: *str,
            bytes: list<u8>, last: usize);

        pred_ctor SearcherCursorContent<S>(t: thread_id_t, p: *S, haystack: *str,
            bytes: list<u8>, cursor: i32)() =
            *p |-> ?state &*& <S>.own(t, state) &*&
            [1/2]ghost_cell::<usize>(cursor, ?last) &*&
            SearcherPosition::<S>(t, state, haystack, bytes, last);

        inductive SearcherLoan = OrdinarySearcher
            | PositionedSearcher(*str, list<u8>, i32, usize);

        pred SearcherBorrow<S>(k: lifetime_t, t: thread_id_t, p: *S, loan: SearcherLoan) =
            match loan {
                OrdinarySearcher => full_borrow(k, (<S>.full_borrow_content)(t, p)),
                PositionedSearcher(haystack, bytes, cursor, last) =>
                    full_borrow(k, SearcherCursorContent::<S>(t, p, haystack, bytes, cursor)) &*&
                    [1/2]ghost_cell::<usize>(cursor, last)
            };

        fix after_match(loan: SearcherLoan, end: usize) -> SearcherLoan {
            match loan {
                OrdinarySearcher => OrdinarySearcher,
                PositionedSearcher(haystack, bytes, cursor, last) =>
                    PositionedSearcher(haystack, bytes, cursor, end)
            }
        }

        fix next_match_range(loan: SearcherLoan, start: usize, end: usize) -> bool {
            match loan {
                OrdinarySearcher => true,
                PositionedSearcher(haystack, bytes, cursor, last) =>
                    last <= start && start <= end && end <= length(bytes) &&
                    is_char_boundary(bytes, start) && is_char_boundary(bytes, end)
            }
        }

        fix front_agrees(loan: SearcherLoan, front: usize) -> bool {
            match loan {
                OrdinarySearcher => true,
                PositionedSearcher(haystack, bytes, cursor, last) =>
                    front == last && last <= length(bytes) && is_char_boundary(bytes, last)
            }
        }

        lem next_match_advances_front(loan: SearcherLoan, start: usize, end: usize)
            req next_match_range(loan, start, end) == true;
            ens front_agrees(after_match(loan, end), end) == true;
        {
            match loan {
                OrdinarySearcher => {}
                PositionedSearcher(source, bytes, cursor, last) => {}
            }
        }
        @*/

        mod Pattern {
            // Rustc exports this GAT projection with the haystack lifetime
            // and the input pattern type. This symbol identifies the type only.
            //@ fix Searcher_typeid(haystack_lifetime: *_, pattern_type: *_) -> *_;

            fn into_searcher<P, 'h>(self: P, haystack: &'h str) -> <P as std::str::pattern::Pattern<'h>>::Searcher;
            /*@
            req thread_token(?t) &*& <P>.own(t, self) &*& [?q]lifetime_token('h) &*&
                str_share('h, t, haystack) &*& exists(?bytes) &*&
                [_]frac_borrow('h, mk_array::<u8>(haystack as *u8, haystack.len(), bytes));
            @*/
            /*@
            ens thread_token(t) &*& [q]lifetime_token('h) &*& str_share('h, t, haystack) &*&
                < <P as std::str::pattern::Pattern<'h>>::Searcher>.own(t, result) &*&
                std::str::pattern::SearcherPosition::< <P as std::str::pattern::Pattern<'h>>::Searcher>
                    (t, result, haystack, bytes, 0);
            @*/
            //@ on_unwind_ens thread_token(t) &*& [q]lifetime_token('h) &*& str_share('h, t, haystack);
        }

        trait Searcher<'haystack> {
            // Both variants retain the exclusive borrow. The positioned loan
            // also stores the documented watermark of successful matches.
            fn next_match<'call>(self: &'call mut Self) -> std::option::Option<(usize, usize)>;
            /*@
            req thread_token(?t) &*& exists(?loan) &*&
                std::str::pattern::SearcherBorrow::<Self>(?k, t, self, loan) &*& [?q]lifetime_token(k);
            @*/
            /*@
            ens thread_token(t) &*& [q]lifetime_token(k) &*&
                <std::option::Option<(usize, usize)>>.own(t, result) &*&
                match result {
                    Option::None => std::str::pattern::SearcherBorrow::<Self>(k, t, self, loan),
                    Option::Some(pair) =>
                        std::str::pattern::SearcherBorrow::<Self>(k, t, self,
                            std::str::pattern::after_match(loan, pair.1)) &*&
                        std::str::pattern::next_match_range(loan, pair.0, pair.1) == true
                };
            @*/
            //@ on_unwind_ens thread_token(t) &*& [q]lifetime_token(k) &*& std::str::pattern::SearcherBorrow::<Self>(k, t, self, loan);
        }
    }

    struct Bytes<'a>;

    /*@
    fix Bytes::as_str<'a>(b: Bytes<'a>) -> *str;
    fix bytes_iter_str<I>(iter: I) -> *str;
    fix is_str_bytes_iter<I>() -> bool;

    lem_auto(bytes_iter_str::<std::str::Bytes<'a>>(b)) bytes_iter_str_Bytes<'a>(b: std::str::Bytes<'a>);
        req true;
        ens bytes_iter_str::<std::str::Bytes<'a>>(b) == b.as_str();

    lem_auto(is_str_bytes_iter::<std::str::Bytes<'a>>()) is_str_bytes_iter_Bytes<'a>();
        req true;
        ens is_str_bytes_iter::<std::str::Bytes<'a>>() == true;

    lem Chars_as_str_upcast<'a0, 'a1>(c: std::str::Chars<'a0>);
        req true;
        ens upcast::<std::str::Chars<'a0>, std::str::Chars<'a1>>(c).as_str() == c.as_str();

    // Lifetimes are erased in MIR; `Chars::as_str` depends only on the `Chars` value, not its lifetime argument.
    lem Chars_as_str_lft<'a0, 'a1>(c: std::str::Chars<'a0>);
        req true;
        ens std::str::Chars::as_str::<'a1>(c) == std::str::Chars::as_str::<'a0>(c);

    // Lifetimes are erased in MIR; `Chars<'a0>` and `Chars<'a1>` have identical memory representation.
    lem points_to_Chars_lft<'a0, 'a1>(p: *std::str::Chars<'a0>);
        req [?f](*p |-> ?c);
        ens [f](*(p as *std::str::Chars<'a1>) |-> c) &*&
            std::str::Chars::as_str::<'a1>(c) == std::str::Chars::as_str::<'a0>(c);

    lem usize_upcast(n: usize);
        req true;
        ens upcast::<usize, usize>(n) == n;

    @*/

    impl str {

        // `str::is_char_boundary(index)` returns true iff `index` is a UTF-8 char boundary
        // (0, len, or a non-continuation byte).
        fn is_char_boundary<'a>(self: &'a str, index: usize) -> bool;
        //@ req [?f](self as *u8)[..self.len()] |-> ?bs;
        //@ ens [f](self as *u8)[..self.len()] |-> bs &*& result == is_char_boundary(bs, index);
        //@ on_unwind_ens false;

        // `str::bytes` returns a byte iterator over the slice's bytes.
        fn bytes<'a>(self: &'a str) -> std::str::Bytes<'a>;
        //@ req true;
        //@ ens result.as_str() == self;
        //@ on_unwind_ens false;

    }

    impl<'a> std::iter::DoubleEndedIterator for std::str::Chars<'a> {

        // Decodes the last UTF-8 sequence of the remaining bytes (documented std contract
        // of `Chars::next_back` / `next_code_point_reverse`).
        fn next_back<'b>(self: &'b mut std::str::Chars<'a>) -> std::option::Option<char>;
        //@ req *self |-> ?chars0 &*& [?f](chars0.as_str() as *u8)[..chars0.as_str().len()] |-> ?bs &*& is_valid_utf8(bs) == true;
        /*@
        ens [f](chars0.as_str() as *u8)[..chars0.as_str().len()] |-> bs &*& *self |-> ?chars1 &*&
            match result {
                Option::None => bs == [] &*& chars1.as_str() == chars0.as_str(),
                Option::Some(c) =>
                    bs != [] &*&
                    is_unicode_scalar_value(c) == true &*&
                    1 <= char_len_utf8(c) &*& char_len_utf8(c) <= length(bs) &*&
                    drop(length(bs) - char_len_utf8(c), bs) == char_utf8(c) &*&
                    is_valid_utf8(take(length(bs) - char_len_utf8(c), bs)) == true &*&
                    chars1.as_str() as *u8 == chars0.as_str() as *u8 &*&
                    chars1.as_str().len() == chars0.as_str().len() - char_len_utf8(c)
            };
        @*/
        //@ on_unwind_ens false;

    }

}

mod iter {

    struct FromFn<F>(F)

    struct Once<T>;
    struct Chain<A, B> {
        a: std::option::Option<A>,
        b: std::option::Option<B>,
    }

    /*@
    // The remaining initialized elements of Vec's owning iterator and
    // the optional element held by Once. These states carry their ownership.
    pred VecRejectionIter<T>(t: thread_id_t,
        iter: std::vec::IntoIter<T, std::alloc::Global>; remaining: list<T>);
    pred OnceRejectionIter<T>(t: thread_id_t, iter: Once<T>; pending: std::option::Option<T>);

    pred OptionalVecRejections<T>(t: thread_id_t,
        iter: std::option::Option<std::vec::IntoIter<T, std::alloc::Global>>; remaining: list<T>) =
        match iter {
            Option::None => remaining == nil,
            Option::Some(a) => VecRejectionIter(t, a, remaining)
        };

    pred OptionalOnceRejections<T>(t: thread_id_t,
        iter: std::option::Option<Once<T>>; remaining: list<T>) =
        match iter {
            Option::None => remaining == nil,
            Option::Some(b) => OnceRejectionIter(t, b, ?pending) &*&
                remaining == match pending { Option::None => nil, Option::Some(pair) => cons(pair, nil) }
        };

    pred RejectionChain<T>(t: thread_id_t,
        iter: Chain<std::vec::IntoIter<T, std::alloc::Global>, Once<T>>; remaining: list<T>) =
        OptionalVecRejections(t, iter.a, ?left) &*& OptionalOnceRejections(t, iter.b, ?right) &*&
        remaining == append(left, right);

