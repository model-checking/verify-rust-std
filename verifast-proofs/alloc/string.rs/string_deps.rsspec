mod char {

    struct DecodeUtf16<I>;
    struct DecodeUtf16Error {
        code: u16,
    }

    /*@
    pred_fam_inst DecodeUtf16Error_own()(t: thread_id_t, error: DecodeUtf16Error) =
        0xd800 <= error.code &*& error.code < 0xe000;

    lem char_utf8_valid_for_scalar(c: char);
        req is_unicode_scalar_value(c) == true;
        ens is_valid_utf8(char_utf8(c)) == true;
    @*/

    mod methods {
        impl char {
            fn decode_utf16<I>(iter: I) -> std::char::DecodeUtf16<I>;
            //@ req thread_token(?t) &*& <I>.own(t, iter);
