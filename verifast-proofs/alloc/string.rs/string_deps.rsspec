        @*/
        //@ on_unwind_ens false;

        specialize<T, 'a> std::iter::Iterator::next<std::iter::Chain<std::vec::IntoIter<T, std::alloc::Global>, std::iter::Once<T>>, 'a> as next_forward_chain;
        fn next_forward_chain<T, 'a>(self: &'a mut std::iter::Chain<std::vec::IntoIter<T, std::alloc::Global>, std::iter::Once<T>>)
            -> std::option::Option<T>;
        //@ req thread_token(?t) &*& *self |-> ?value &*& std::iter::RejectionChain(t, value, ?rest);
        /*@
        ens thread_token(t) &*& *self |-> ?next &*&
