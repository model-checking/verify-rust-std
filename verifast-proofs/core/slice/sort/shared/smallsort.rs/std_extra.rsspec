// Trusted specifications for the std functions that the challenge code calls and that VeriFast 26.10's
// prelude (std/lib.rsspec and the translator's built-ins) does not specify. VeriFast assumes them
// without proof. Each spec follows the function's documentation in core. Every crate under targets/
// contains this file verbatim (checked by verify.sh) and loads it with `-extern_spec std=...`.
// The std calls that cannot be specified here go through the wrappers at the end of smallsort.rs.

mod array {

    // The array iterator used by `for offset in [0, len_div_2]`; its specs are on the wrappers
    // `array_0_and_into_iter__VeriFast_wrapper` and `array_usize_2_into_iter_next__VeriFast_wrapper`.
    struct IntoIter<T, N>;

}

mod hint {

    // Returns `true_val` if `condition` is true and `false_val` otherwise; the other value is dropped
    // (which may panic). For raw pointers, `<*T>.own` is `raw_ptr_own`, which a caller can close.
    fn select_unpredictable<T>(condition: bool, true_val: T, false_val: T) -> T;
    //@ req thread_token(?t) &*& <T>.own(t, true_val) &*& <T>.own(t, false_val);
    //@ ens thread_token(t) &*& <T>.own(t, result) &*& result == if condition { true_val } else { false_val };
    //@ on_unwind_ens thread_token(t);

}

mod intrinsics {

    // Aborts the process: never returns, never unwinds. The challenge code calls it as
    // `intrinsics::abort_immediate`, which lib.rs re-exports from this function (see README.md).
    fn abort();
    //@ req true;
    //@ ens false;
    //@ on_unwind_ens false;

}

mod num {

    impl usize {

        // Whether `self` is an integer multiple of `rhs`; for `rhs == 0`, whether `self == 0`.
        fn is_multiple_of(self: usize, rhs: usize) -> bool;
        //@ req true;
        //@ ens result == if rhs == 0 { self == 0 } else { self % rhs == 0 };
        //@ on_unwind_ens false;

    }

}

mod slice {

    /*@

    // The length of a slice is a `usize` (VeriFast 26.10 models it as `ptr_len(s)`, the pointer's
    // metadata, without this range fact).
    lem slice_len_range<T>(s: *[T]);
        req true;
        ens 0 <= s.len() && s.len() <= usize::MAX;

    @*/

    // Safety: `data` must be non-null, properly aligned, and point to `len` initialized values of type
    // `T`, readable for 'a; `len * size_of::<T>()` must be at most `isize::MAX`. The same form as
    // VeriFast's spec of `from_raw_parts_mut`, with read-only (fractional) access.
    unsafe fn from_raw_parts<'a, T>(data: *const T, len: usize) -> &'a [T];
    //@ req [?f]data[..len] |-> ?vs &*& data != 0 &*& data as usize % std::mem::align_of::<T>() == 0 &*& len * std::mem::size_of::<T>() <= isize::MAX;
    //@ ens [f]data[..len] |-> vs &*& result as *T == data &*& result.len() == len;
    //@ on_unwind_ens false;

}
